 generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  TEAM_LEAD
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ON_HOLD
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  role       UserRole

  employee   Employee?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted  Boolean  @default(false)

  @@index([role])
  @@index([isDeleted])
}

model Employee {
  id            Int            @id @default(autoincrement())
  employeeCode  String         @unique
  firstName     String
  lastName      String
  email         String         @unique
  phone         String?
  department    String?
  designation   String?
  joiningDate   DateTime
  status        EmployeeStatus

  userId        Int?           @unique
  user          User?          @relation(fields: [userId], references: [id])

  taskAssignments TaskAssignment[]
  attendances     Attendance[]
  workLogs        WorkLog[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)

  @@index([status])
  @@index([department])
  @@index([isDeleted])
}

model Client {
  id             Int          @id @default(autoincrement())
  clientCode     String       @unique
  companyName    String
  contactPerson  String
  email          String       @unique
  phone          String?
  gstNumber      String?      @unique
  panNumber      String?      @unique
  address        String?
  status         ClientStatus

  tasks          Task[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  isDeleted      Boolean      @default(false)

  @@index([status])
  @@index([companyName])
  @@index([isDeleted])
}

model Task {
  id            Int           @id @default(autoincrement())
  title         String
  description   String?

  status        TaskStatus    @default(PENDING)
  priority      TaskPriority  @default(MEDIUM)

  startDate     DateTime?
  dueDate       DateTime?

  clientId      Int
  client        Client        @relation(fields: [clientId], references: [id])

  assignments   TaskAssignment[]
  workLogs      WorkLog[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isDeleted     Boolean       @default(false)

  @@index([status])
  @@index([priority])
  @@index([clientId])
  @@index([dueDate])
  @@index([isDeleted])
}

model TaskAssignment {
  id          Int       @id @default(autoincrement())

  taskId      Int
  employeeId  Int

  assignedAt  DateTime  @default(now())

  task        Task      @relation(fields: [taskId], references: [id])
  employee    Employee  @relation(fields: [employeeId], references: [id])

  @@index([taskId])
  @@index([employeeId])
}

model Attendance {
  id                 Int               @id @default(autoincrement())

  employeeId         Int

  checkInTime        DateTime?
  checkOutTime       DateTime?

  checkInLatitude    Float?
  checkInLongitude   Float?

  checkOutLatitude   Float?
  checkOutLongitude  Float?

  checkInAddress     String?
  checkOutAddress    String?

  status             AttendanceStatus

  employee           Employee          @relation(fields: [employeeId], references: [id])

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([employeeId])
}

model WorkLog {
  id                   Int        @id @default(autoincrement())

  employeeId           Int
  taskId               Int

  description          String
  completionPercentage Int

  employee             Employee   @relation(fields: [employeeId], references: [id])
  task                 Task       @relation(fields: [taskId], references: [id])

  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([employeeId])
  @@index([taskId])
}